# URL de production de votre application sur Vercel
NEXTAUTH_URL="https://votre-cabinet.vercel.app"

# 3. Compte Super Administrateur (Accès direct via /admin)
SUPERADMIN_EMAIL="nahliamine95@gmail.com"
SUPERADMIN_PASSWORD="nahliamine95@gmail.com"

# 4. Service d'envoi d'e-mails professionnels (Resend)
